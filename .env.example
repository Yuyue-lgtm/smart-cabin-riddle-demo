DIFY_CHATFLOW_API_KEY=replace_with_your_dify_chatflow_api_key
DIFY_CHATFLOW_APP_ID=b8bff994-d397-484e-8ccd-11851e6cc460
DIFY_SITUATION_API_KEY=replace_with_your_dify_situation_api_key
DIFY_SITUATION_APP_ID=6e3c5968-1a66-443d-9a2d-a6c62ff248eb
DIFY_PREVIEW_API_KEY=replace_with_your_dify_question_preview_api_key
DIFY_PREVIEW_APP_ID=aa30333f-4a8d-4d89-9d6f-557ee7296263
# Local Demo uses independent ECS TEST apps through the private forwarding tunnel.
# Production uses its original app IDs and private keys on ECS.
DIFY_API_BASE_URL=http://127.0.0.1:8081
DIFY_ENVIRONMENT=alibaba-test
PORT=4175
# Optional server-only Alibaba Model Studio CosyVoice configuration.
# Create the API key in Singapore; never expose it through client-side variables.
COSYVOICE_API_KEY=
COSYVOICE_API_BASE_URL=https://dashscope-intl.aliyuncs.com
# Optional: override the default timeout used by both BFF routes.
# DIFY_BFF_TIMEOUT_MS=60000
